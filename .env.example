# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://consensia:consensia@localhost:5432/consensia?schema=public"

# ── Auth.js ───────────────────────────────────────────────────────────────────
# Generate with:  npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET=""
# Set to true when running behind a reverse proxy that is not Vercel.
AUTH_TRUST_HOST=true

# Public base URL used in email links (no trailing slash).
APP_URL="http://localhost:3000"

# ── Email (Resend) ────────────────────────────────────────────────────────────
# Leave RESEND_API_KEY empty in development: emails are printed to the server console instead.
RESEND_API_KEY=""
# Optional override: "resend" or "console". Production without a key needs EMAIL_TRANSPORT=console
# explicitly (test deployments only), so a missing key never silently drops real email.
EMAIL_TRANSPORT=""
EMAIL_FROM="Consensia <no-reply@example.com>"

# ── Seed (npm run db:seed) — first ADMIN account ──────────────────────────────
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME="Administrator"

# ── App ───────────────────────────────────────────────────────────────────────
# Time zone for displayed dates and date filters.
APP_TIME_ZONE="Europe/Warsaw"
# Uploaded images (kept outside /public; served only to signed-in users).
# On serverless hosting use persistent storage instead (see src/lib/storage.ts).
UPLOAD_DIR="storage/uploads"

# Scheduled housekeeping (expired sessions/tokens, abandoned sign-ups, orphan uploads,
# closing resolutions past their deadline). Call hourly:
#   curl -fsS -H "Authorization: Bearer $CRON_SECRET" https://your-domain/api/cron/maintenance
# Generate with: openssl rand -base64 33   — leave empty to disable the endpoint.
CRON_SECRET=""

# Optional: `npm run db:seed` also creates demo articles when "true".
SEED_DEMO_CONTENT="false"

# ── Docker deployment only (docker-compose.yml) ──────────────────────────────
# Public domain served by Caddy with automatic HTTPS; set APP_URL="https://<DOMAIN>" too.
DOMAIN=""
# Password of the PostgreSQL container (DATABASE_URL above is replaced by compose).
POSTGRES_PASSWORD=""
